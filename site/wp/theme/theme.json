{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "layout": { "contentSize": "1120px", "wideSize": "1120px" },
    "color": {
      "defaultPalette": false,
      "palette": [
        { "slug": "primary", "name": "Primary", "color": "#0b2a4a" },
        { "slug": "primary-2", "name": "Primary light", "color": "#12467a" },
        { "slug": "accent", "name": "Accent", "color": "#f59e0b" },
        { "slug": "surface", "name": "Surface", "color": "#f3f6fb" },
        { "slug": "text", "name": "Text", "color": "#0f1f33" },
        { "slug": "muted", "name": "Muted", "color": "#55667a" },
        { "slug": "line", "name": "Line", "color": "#dde5ef" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "typography": {
      "fontFamilies": [
        {
          "slug": "system",
          "name": "System",
          "fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif"
        }
      ]
    }
  },
  "styles": {
    "color": { "background": "#ffffff", "text": "#0f1f33" },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--system)",
      "fontSize": "1rem",
      "lineHeight": "1.6"
    },
    "spacing": { "blockGap": "0" },
    "elements": {
      "link": {
        "color": { "text": "#12467a" },
        "typography": { "textDecoration": "none" },
        ":hover": { "typography": { "textDecoration": "underline" } }
      }
    }
  },
  "templateParts": [
    { "name": "header", "title": "Header", "area": "header" },
    { "name": "drawer", "title": "Mobile drawer", "area": "uncategorized" },
    { "name": "footer", "title": "Footer", "area": "footer" },
    { "name": "bottom-nav", "title": "Bottom navigation", "area": "uncategorized" }
  ]
}